{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mail2Telegram",
  "version": "0.2.0",
  "identifier": "com.mail2telegram.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mail2Telegram",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Turn emails into Telegram posts",
    "longDescription": "Desktop automation for turning Gmail messages into AI-assisted Telegram posts."
  }
}
