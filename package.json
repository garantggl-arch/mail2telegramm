{
  "name": "mail2telegram",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron": "electron .",
    "electron:build": "electron-builder --win"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@vitejs/plugin-react": "4.3.4",
    "electron-builder": "24.13.3",
    "typescript": "5.4.5",
    "vite": "4.5.14"
  },
"build": {
  "publish": null,
  "appId": "com.mail2telegram.desktop",
  "productName": "Mail2Telegram",
  "directories": {
    "output": "release"
  },
"files": [
  "dist/**/*",
  "electron/main.cjs",
  "electron/preload.cjs",
  "package.json"
],
  "extraMetadata": {
  "main": "electron/main.cjs"
},
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "src-tauri/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
}
